local AURA_CONFIG = {
    Enabled = false,
    Range = 27,
    MaxAttacksPerSecond = 10,
    BurstSize = 2,
    ScanInterval = 0,
    TargetPlayers = true,
    TargetNPCs = true,
}

local AttackRemote = nil
local isAuraRemoteEvent = false

local function findAttackRemote()
    local possiblePaths = {
        ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("ActionsSystem") and ReplicatedStorage.Systems.ActionsSystem.Network:FindFirstChild("Attack"),
        ReplicatedStorage:FindFirstChild("Systems") and ReplicatedStorage.Systems:FindFirstChild("Combat") and ReplicatedStorage.Systems.Combat:FindFirstChild("Attack"),
        ReplicatedStorage:FindFirstChild("Combat") and ReplicatedStorage.Combat:FindFirstChild("Attack"),
        ReplicatedStorage:FindFirstChild("Game") and ReplicatedStorage.Game:FindFirstChild("Attack"),
        ReplicatedStorage:FindFirstChild("Attack"),
        ReplicatedStorage:FindFirstChild("Remote") and ReplicatedStorage.Remote:FindFirstChild("Attack"),
    }
    for _, remote in ipairs(possiblePaths) do
        if remote and (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")) then
            return remote
        end
    end
    local function deepScan(folder)
        for _, child in folder:GetChildren() do
            if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                local lowerName = child.Name:lower()
                if lowerName:find("attack") or lowerName:find("combat") or lowerName:find("damage") or lowerName:find("hit") then
                    return child
                end
            end
            if child:IsA("Folder") or child:IsA("Model") then
                local found = deepScan(child)
                if found then return found end
            end
        end
        return nil
    end
    return deepScan(ReplicatedStorage)
end

AttackRemote = findAttackRemote()
if AttackRemote then
    isAuraRemoteEvent = AttackRemote:IsA("RemoteEvent")
end

local EntityManager = {
    cache = {},
    lastScan = 0,
    refresh = function(self)
        local newCache = {}
        if AURA_CONFIG.TargetPlayers then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local char = player.Character
                    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                        table.insert(newCache, { character = char, hrp = char.HumanoidRootPart, humanoid = char.Humanoid, type = "player" })
                    end
                end
            end
        end
        if AURA_CONFIG.TargetNPCs then
            for _, child in Workspace:GetChildren() do
                if child:IsA("Model") and child ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(child) then
                    local hrp = child:FindFirstChild("HumanoidRootPart")
                    local hum = child:FindFirstChild("Humanoid")
                    if hrp and hum and hum.Health > 0 then
                        table.insert(newCache, { character = child, hrp = hrp, humanoid = hum, type = "npc" })
                    end
                end
            end
        end
        self.cache = newCache
        self.lastScan = tick()
    end,
    getNearest = function(self, origin, maxDist)
        local best = nil
        local bestDist = maxDist * maxDist
        for _, target in ipairs(self.cache) do
            if target.hrp and target.hrp.Parent then
                local dx = target.hrp.Position.X - origin.X
                local dy = target.hrp.Position.Y - origin.Y
                local dz = target.hrp.Position.Z - origin.Z
                local distSq = dx*dx + dy*dy + dz*dz
                if distSq < bestDist then
                    bestDist = distSq
                    best = target
                end
            end
        end
        return best
    end
}

local auraLastAttackTime = 0
local auraAttackCounter = 0
local auraRateLimitHit = false
local auraRateLimitRecoveryTime = 0

local function sendAttack(target)
    if not AttackRemote or not target or not target.character then return false end
    if auraRateLimitHit then
        if tick() - auraRateLimitRecoveryTime < 3 then return false else auraRateLimitHit = false end
    end
    local now = tick()
    local timeBetweenAttacks = 1 / AURA_CONFIG.MaxAttacksPerSecond
    if now - auraLastAttackTime < timeBetweenAttacks then return false end

    local attempts = {
        function() if isAuraRemoteEvent then AttackRemote:FireServer(target.character, 1) else AttackRemote:InvokeServer(target.character, 1) end end,
        function() if isAuraRemoteEvent then AttackRemote:FireServer(target.character, target.humanoid, 1) else AttackRemote:InvokeServer(target.character, target.humanoid, 1) end end,
        function() if isAuraRemoteEvent then AttackRemote:FireServer(target.hrp, 1) else AttackRemote:InvokeServer(target.hrp, 1) end end,
        function() if isAuraRemoteEvent then AttackRemote:FireServer(target.character, 10) else AttackRemote:InvokeServer(target.character, 10) end end,
        function() if isAuraRemoteEvent then AttackRemote:FireServer(target.character) else AttackRemote:InvokeServer(target.character) end end
    }

    local success = false
    for _, attempt in ipairs(attempts) do
        local result, err = pcall(attempt)
        if result then
            success = true
            auraLastAttackTime = now
            auraAttackCounter = auraAttackCounter + 1
            break
        else
            if err and string.find(tostring(err):lower(), "rate") then
                auraRateLimitHit = true
                auraRateLimitRecoveryTime = now
                break
            end
        end
    end
    return success
end

local function attackLoop()
    if not AURA_CONFIG.Enabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if tick() - EntityManager.lastScan > AURA_CONFIG.ScanInterval then
        EntityManager:refresh()
    end

    local target = EntityManager:getNearest(hrp.Position, AURA_CONFIG.Range)
    if not target then return end

    for i = 1, AURA_CONFIG.BurstSize do
        if sendAttack(target) then
            if i < AURA_CONFIG.BurstSize then task.wait(0.03) end
        else
            break
        end
    end
end
RunService.Heartbeat:Connect(attackLoop)

